              <figcaption>King’s College London · 2025</figcaption>
            </figure>
            <figure class="about-photo-card">
              <span class="about-card-corner" aria-hidden="true"><span>K</span><span>♣</span></span>
              <button class="about-photo-open" type="button" data-about-photo-open aria-haspopup="dialog" disabled>
                <img
                  src="{{ '/assets/img/portfolio/doris-portrait.webp' | relative_url }}"
