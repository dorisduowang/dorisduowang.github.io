              <span class="about-card-corner about-card-corner-reversed" aria-hidden="true"><span>K</span><span>♣</span></span>
              <figcaption>Portrait</figcaption>
            </figure>
            <figure class="about-photo-card about-photo-card-flowers">
              <span class="about-card-corner" aria-hidden="true"><span>Q</span><span>♦</span></span>
              <button class="about-photo-open" type="button" data-about-photo-open aria-haspopup="dialog" disabled>
                <img
                  src="{{ '/assets/img/portfolio/flower-portrait.webp' | relative_url }}"
