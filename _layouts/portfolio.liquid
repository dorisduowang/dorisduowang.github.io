          </div>
        </div>
        <dialog class="about-photo-dialog" data-about-photo-dialog aria-labelledby="about-photo-caption" aria-describedby="about-photo-description">
          <figure class="about-photo-enlarged">
            <button class="about-photo-dismiss" type="button" data-about-photo-dismiss aria-label="Close enlarged photo" autofocus>
