<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {{ page.title | escape }}
      | Research
    </title>
    <meta name="description" content="{{ page.description | escape }}">
    <meta name="theme-color" content="#000000">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ page.title | escape }}">
    <meta property="og:description" content="{{ page.description | escape }}">
    <meta property="og:image" content="{{ '/assets/img/portfolio/doris-centered-poster.webp' | absolute_url }}">
    <meta property="og:image:alt" content="Doris Wang wearing a black sleeveless top and a heart pendant">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link rel="icon" type="image/png" href="{{ '/assets/img/portfolio/doris-mark.png' | relative_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/landing.css' | relative_url | bust_file_cache }}">
    <script defer src="{{ '/assets/js/landing.js' | relative_url | bust_file_cache }}"></script>
  </head>
  <body>
    {% assign portfolio_url = '/portfolio/' | relative_url %}
    {% capture navigation %}
      <a href="{{ portfolio_url }}#research">Research</a>
      <a href="{{ portfolio_url }}#about">About</a>
      <a href="{{ portfolio_url }}#graduation">KCL Graduation</a>
      <a href="{{ '/cv/' | relative_url }}">CV</a>
      <a href="{{ portfolio_url }}#contact">Contact</a>
    {% endcapture %}
    <div class="landing-shell" data-landing data-portfolio-url="{{ portfolio_url }}" data-motion="paused">
      <a class="skip-link" href="#main">Skip to content</a>
      <header class="landing-header">
        <a class="identity" href="{{ '/' | relative_url }}" aria-label="Doris Wang, home">
          <span class="identity-mark" aria-hidden="true">DW</span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {{ navigation }}
        </nav>
        <details class="mobile-menu">
          <summary><span>Menu</span><i aria-hidden="true"></i></summary>
          <nav aria-label="Mobile navigation">
            {{ navigation }}
          </nav>
        </details>
      </header>

      <main class="landing-main" id="main">
        <section class="hero-meta" aria-label="Profile and research focus">
          <div class="profile-heading">
            <p class="profile-name">Doris Wang</p>
            <p class="profile-name-alt"><span lang="zh-Hans">王朵</span><span aria-hidden="true">·</span> Wáng Duǒ</p>
          </div>
          <div class="research-heading">
            <p class="meta-label">Research focus</p>
            <p class="meta-copy">I study cooperation and incentives using experiments, data, and AI agents.</p>
          </div>
          <div class="affiliation-heading">
            <p class="meta-label">University of Chicago</p>
            <p class="meta-copy">Computational Social Science · Economics</p>
          </div>
        </section>
        <div class="portrait-stage">
          <div class="portrait-plate" role="img" aria-label="Animated portrait of Doris Wang in a black sleeveless top">
            <img
              class="landing-portrait"
              src="{{ '/assets/img/portfolio/doris-centered-poster.webp' | relative_url }}"
              width="1104"
              height="1024"
              alt=""
              fetchpriority="high"
            >
            <video
              class="landing-video"
              data-source="{{ '/assets/video/doris-centered-loop.mp4' | relative_url }}"
              muted
              loop
              playsinline
              preload="none"
              aria-hidden="true"
            ></video>
          </div>
        </div>

        <div class="hero-content">
          <h1>The rules of <em>cooperation.</em></h1>
          <div class="hero-actions">
            <a class="primary-link" href="{{ portfolio_url }}#research">Explore research</a>
            <a class="graduation-link" href="{{ portfolio_url }}#graduation">KCL graduation</a>
          </div>
        </div>
      </main>

      <footer class="landing-footer">
        <span
          ><span class="footer-affiliation">University of Chicago</span><span class="footer-separator" aria-hidden="true"></span
          ><span class="footer-location">Chicago, IL</span></span
        >
        <button class="motion-toggle" type="button" data-motion-toggle hidden>
          <i aria-hidden="true"></i>
          <span>Play motion</span>
        </button>
      </footer>
    </div>
  </body>
</html>
